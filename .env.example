# WhatsApp Web (used only when WHATSAPP_PROVIDER=web_js)
WHATSAPP_WEB_JS_AUTH_PATH=
WHATSAPP_WEB_JS_CLIENT_ID=
WHATSAPP_WEB_JS_RECONNECT_DELAY_MS=10000
PUPPETEER_EXECUTABLE_PATH=
# App
NODE_ENV=
PORT=
ADMIN_WHATSAPP_NUMBERS=
GEMINI_RPM_LIMIT=
GEMINI_RPD_LIMIT=
ADMIN_ALERT_WHATSAPP_NUMBER=
