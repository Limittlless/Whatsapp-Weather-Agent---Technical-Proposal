# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# WhatsApp provider: cloud_api (default) or web_js
WHATSAPP_PROVIDER=cloud_api
# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
